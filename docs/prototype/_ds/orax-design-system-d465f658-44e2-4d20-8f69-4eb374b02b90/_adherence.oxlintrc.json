{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/game/**",
              "components/icons/**",
              "components/shared/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Silkscreen))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Silkscreen."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|block|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, block, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|appearance|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, appearance, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ruby|sapphire|emerald|brand)$/]",
        "message": "<Chip> variant must be one of 'ruby' | 'sapphire' | 'emerald' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:filled|outline|subtle)$/]",
        "message": "<Chip> appearance must be one of 'filled' | 'outline' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassCardGem'] > JSXAttribute > JSXIdentifier[name!=/^(?:gem|active|onClick|key|ref|className|style|children)$/]",
        "message": "<ClassCardGem> doesn't accept that prop. Declared props: gem, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassCardGem'] > JSXAttribute[name.name='gem'] > Literal[value!=/^(?:ruby|sapphire|emerald)$/]",
        "message": "<ClassCardGem> gem must be one of 'ruby' | 'sapphire' | 'emerald'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cover'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|scale|key|ref|className|style|children)$/]",
        "message": "<Cover> doesn't accept that prop. Declared props: theme, scale."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cover'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Cover> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GemSocket'] > JSXAttribute > JSXIdentifier[name!=/^(?:gem|active|size|onClick|label|key|ref|className|style|children)$/]",
        "message": "<GemSocket> doesn't accept that prop. Declared props: gem, active, size, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='GemSocket'] > JSXAttribute[name.name='gem'] > Literal[value!=/^(?:ruby|sapphire|emerald)$/]",
        "message": "<GemSocket> gem must be one of 'ruby' | 'sapphire' | 'emerald'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|ground|alt|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: height, ground, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:auto|dark|light|white)$/]",
        "message": "<Logo> ground must be one of 'auto' | 'dark' | 'light' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tagline'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|align|key|ref|className|style|children)$/]",
        "message": "<Tagline> doesn't accept that prop. Declared props: size, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tagline'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<Tagline> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tagline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Tagline> align must be one of 'left' | 'center' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
